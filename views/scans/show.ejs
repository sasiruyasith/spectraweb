<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= scan.title %> <span class="tag tag-<%= scan.band.toLowerCase() %>"><%= scan.band %></span></h1>
  <div class="btn-row">
    <a href="/scans/<%= scan.id %>/edit" class="btn">Edit</a>
    <form method="post" action="/scans/<%= scan.id %>/delete" data-confirm="Delete this scan? This cannot be undone.">
      <button class="btn btn-danger">Delete</button>
    </form>
  </div>
</div>

<div class="card">
  <canvas id="spectrum" height="260"
    data-start="<%= scan.start_freq_mhz %>" data-stop="<%= scan.stop_freq_mhz %>"
    data-peak="<%= scan.peak_freq_mhz %>" data-power="<%= scan.peak_power_dbm %>"
    data-noise="<%= scan.noise_floor_dbm %>"></canvas>
  <p class="muted small">Trace is a simulated view built from the stored peak and noise floor values.</p>
</div>

<div class="card details">
  <div><span>Device</span><%= scan.device_name %> (<%= scan.device_model %>)</div>
  <div><span>Start</span><%= scan.start_freq_mhz %> MHz</div>
  <div><span>Stop</span><%= scan.stop_freq_mhz %> MHz</div>
  <div><span>Span</span><%= +(scan.stop_freq_mhz - scan.start_freq_mhz).toFixed(3) %> MHz</div>
  <div><span>Peak frequency</span><%= scan.peak_freq_mhz %> MHz</div>
  <div><span>Peak power</span><%= scan.peak_power_dbm %> dBm</div>
  <div><span>Noise floor</span><%= scan.noise_floor_dbm %> dBm</div>
  <div><span>SNR</span><%= +(scan.peak_power_dbm - scan.noise_floor_dbm).toFixed(1) %> dB</div>
  <div><span>Location</span><%= scan.location %></div>
  <div><span>Scanned at</span><%= scan.scanned_at.replace('T', ' ') %></div>
  <div class="full"><span>Notes</span><%= scan.notes || '—' %></div>
  <div class="full muted small">Created <%= scan.created_at %> · Last updated <%= scan.updated_at %></div>
</div>

<a href="/scans" class="btn btn-ghost">&larr; Back to list</a>
<%- include('../partials/footer') %>
