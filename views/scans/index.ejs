<%- include('../partials/header') %>
<div class="page-head">
  <h1>Spectrum scans</h1>
  <a href="/scans/new" class="btn">+ New scan</a>
</div>

<form class="filters" method="get" action="/scans">
  <input type="search" name="q" placeholder="Search title, location, notes" value="<%= filters.q %>">
  <select name="band">
    <option value="">All bands</option>
    <% bands.forEach(b => { %><option value="<%= b %>" <%= filters.band === b ? 'selected' : '' %>><%= b %></option><% }) %>
  </select>
  <select name="device">
    <option value="">All devices</option>
    <% devices.forEach(d => { %><option value="<%= d.id %>" <%= String(filters.device) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
  </select>
  <select name="sort">
    <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
    <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
    <option value="power" <%= filters.sort === 'power' ? 'selected' : '' %>>Strongest peak</option>
    <option value="freq" <%= filters.sort === 'freq' ? 'selected' : '' %>>Frequency</option>
    <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title A-Z</option>
  </select>
  <button type="submit" class="btn">Apply</button>
  <a href="/scans" class="btn btn-ghost">Reset</a>
</form>

<p class="muted"><%= scans.length %> scan(s) found</p>

<% if (!scans.length) { %>
  <div class="card center"><p>No scans match. Try a different search or <a href="/scans/new">add one</a>.</p></div>
<% } else { %>
<div class="table-wrap">
<table>
  <thead>
    <tr><th>Title</th><th>Band</th><th>Range (MHz)</th><th>Peak</th><th>Device</th><th>Location</th><th>Date</th><th></th></tr>
  </thead>
  <tbody>
  <% scans.forEach(s => { %>
    <tr>
      <td data-label="Title"><a href="/scans/<%= s.id %>"><%= s.title %></a></td>
      <td data-label="Band"><span class="tag tag-<%= s.band.toLowerCase() %>"><%= s.band %></span></td>
      <td data-label="Range"><%= s.start_freq_mhz %> – <%= s.stop_freq_mhz %></td>
      <td data-label="Peak"><%= s.peak_power_dbm %> dBm @ <%= s.peak_freq_mhz %></td>
      <td data-label="Device"><%= s.device_name %></td>
      <td data-label="Location"><%= s.location %></td>
      <td data-label="Date"><%= s.scanned_at.replace('T', ' ') %></td>
      <td class="actions">
        <a href="/scans/<%= s.id %>/edit" class="btn btn-sm">Edit</a>
        <form method="post" action="/scans/<%= s.id %>/delete" data-confirm="Delete scan '<%= s.title %>'?">
          <button class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('../partials/footer') %>
