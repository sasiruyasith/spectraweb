<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SpectraWeb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a href="/scans" class="brand">Spectra<span>Web</span></a>
  <nav>
    <a href="/scans" class="<%= path.startsWith('/scans') ? 'active' : '' %>">Scans</a>
    <a href="/devices" class="<%= path.startsWith('/devices') ? 'active' : '' %>">Devices</a>
  </nav>
</header>
<main class="container">
<% if (msg) { %>
  <div class="alert <%= msg.startsWith('Cannot') ? 'alert-error' : 'alert-ok' %>"><%= msg %></div>
<% } %>
